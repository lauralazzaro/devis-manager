{% extends 'base.html.twig' %}

{% block title %}Register{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto mt-16">
        <h1 class="text-3xl font-bold text-gray-900 mb-8 text-center">Create account</h1>

        <div class="bg-white rounded-lg border border-gray-200 p-6">
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
                <div>
                    {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>
                <button type="submit" class="w-full bg-gray-900 text-white px-6 py-2 rounded text-sm hover:bg-gray-700 transition">
                    Register
                </button>
            {{ form_end(registrationForm) }}
        </div>

        <p class="text-center text-sm text-gray-500 mt-4">
            Already have an account? <a href="{{ path('app_login') }}" class="text-gray-900 hover:underline">Sign in</a>
        </p>
    </div>
{% endblock %}
