{% extends 'base.html.twig' %}

{% block title %}{{ 'client.show'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-xl">
        <div class="page-header">
            <h1 class="page-title">{{ 'client.show'|trans }}</h1>
            <a href="{{ path('app_client_index') }}" class="link">{{ 'common.back'|trans }}</a>
        </div>

        <div class="card space-y-4 mb-6">
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'client.name'|trans }}</p>
                <p class="text-gray-900 font-medium mt-1">{{ client.name }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'client.email'|trans }}</p>
                <p class="text-gray-600 mt-1">{{ client.email }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'client.address'|trans }}</p>
                <p class="text-gray-600 mt-1">{{ client.address ?? '-' }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'client.phone'|trans }}</p>
                <p class="text-gray-600 mt-1">{{ client.phone ?? '-' }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'client.created_at'|trans }}</p>
                <p class="text-gray-600 mt-1">{{ client.createdAt|date('d/m/Y') }}</p>
            </div>
        </div>

        <div class="flex gap-3">
            <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="btn-primary">{{ 'common.edit'|trans }}</a>
            {{ include('client/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
