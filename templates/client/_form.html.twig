{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
    <div>
        {{ form_label(form.name, 'Name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.name) }}
    </div>
    <div>
        {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.email) }}
    </div>
    <div>
        {{ form_label(form.address, 'Address', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.address, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.address) }}
    </div>
    <div>
        {{ form_label(form.phone, 'Phone', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.phone, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.phone) }}
    </div>
    <button type="submit" class="bg-gray-900 text-white px-6 py-2 rounded text-sm hover:bg-gray-700 transition">
        {{ button_label|default('Save') }}
    </button>
{{ form_end(form) }}
