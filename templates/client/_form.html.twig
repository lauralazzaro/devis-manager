{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
    <div>
        {{ form_label(form.name, 'client.name'|trans, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.name, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.name) }}
    </div>
    <div>
        {{ form_label(form.email, 'client.email'|trans, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.email) }}
    </div>
    <div>
        {{ form_label(form.address, 'client.address'|trans, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.address, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.address) }}
    </div>
    <div>
        {{ form_label(form.phone, 'client.phone'|trans, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.phone, {'attr': {'class': 'form-input'}}) }}
        {{ form_errors(form.phone) }}
    </div>
    <button type="submit" class="btn-primary">
        {{ button_label|default('common.save'|trans) }}
    </button>
{{ form_end(form) }}
