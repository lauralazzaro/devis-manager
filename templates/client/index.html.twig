{% extends 'base.html.twig' %}

{% block title %}{{ 'client.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">{{ 'client.title'|trans }}</h1>
        <a href="{{ path('app_client_new') }}" class="btn-primary">{{ 'client.new'|trans }}</a>
    </div>

    <div class="table-wrapper">
        <table class="w-full text-left">
            <thead class="bg-gray-50">
                <tr>
                    <th class="table-header">{{ 'client.name'|trans }}</th>
                    <th class="table-header">{{ 'client.email'|trans }}</th>
                    <th class="table-header">{{ 'client.phone'|trans }}</th>
                    <th class="table-header">{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for client in clients %}
                <tr class="border-t border-gray-100 hover:bg-gray-50">
                    <td class="table-cell-primary">{{ client.name }}</td>
                    <td class="table-cell">{{ client.email }}</td>
                    <td class="table-cell">{{ client.phone }}</td>
                    <td class="table-cell flex gap-3">
                        <a href="{{ path('app_client_show', {'id': client.id}) }}" class="link">{{ 'common.view'|trans }}</a>
                        <a href="{{ path('app_client_edit', {'id': client.id}) }}" class="link">{{ 'common.edit'|trans }}</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">{{ 'common.no_results'|trans }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
