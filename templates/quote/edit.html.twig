{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.edit'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-xl">
        <div class="page-header">
            <h1 class="page-title">{{ 'quote.edit'|trans }}</h1>
            <a href="{{ path('app_quote_index', {'_locale': app.request.locale}) }}" class="link">{{ 'common.back'|trans }}</a>
        </div>

        <div class="card">
            {{ include('quote/_form.html.twig', {'button_label': 'common.update'|trans}) }}
        </div>

        <div class="mt-4">
            {{ include('quote/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
