{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.show'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-2xl">
        <div class="page-header">
            <h1 class="page-title">{{ 'quote.show'|trans }} {{ quote.quoteNumber }}</h1>
            <a href="{{ path('app_quote_index') }}" class="link">{{ 'common.back'|trans }}</a>
        </div>

        <div class="card space-y-4 mb-6">
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'quote.client'|trans }}</p>
                <p class="text-gray-900 font-medium mt-1">{{ quote.client.name }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'quote.date'|trans }}</p>
                <p class="text-gray-600 mt-1">{{ quote.createdAt|date('d/m/Y') }}</p>
            </div>
            <div>
                <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'quote.status'|trans }}</p>
                <span class="badge mt-1 inline-block">{{ ('status.' ~ quote.status.value)|trans }}</span>
            </div>
        </div>

        <div class="table-wrapper mb-6">
            <table class="w-full text-left">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="table-header">{{ 'quote_line.description'|trans }}</th>
                        <th class="table-header">{{ 'quote_line.quantity'|trans }}</th>
                        <th class="table-header">{{ 'quote_line.unit_price'|trans }}</th>
                        <th class="table-header">{{ 'quote_line.total'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for line in quote.quoteLines %}
                    <tr class="border-t border-gray-100">
                        <td class="table-cell">{{ line.description }}</td>
                        <td class="table-cell">{{ line.quantity }}</td>
                        <td class="table-cell">{{ line.unitPrice }} EUR</td>
                        <td class="table-cell-primary">{{ line.quantity * line.unitPrice }} EUR</td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-8 text-center text-gray-400 text-sm">{{ 'quote.no_lines'|trans }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="flex gap-3">
            <a href="{{ path('app_quote_edit', {'id': quote.id}) }}" class="btn-primary">{{ 'common.edit'|trans }}</a>
            <a href="{{ path('app_quote_pdf', {'id': quote.id}) }}" class="btn-secondary">{{ 'quote.download_pdf'|trans }}</a>
            {{ include('quote/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
