{% extends 'base.html.twig' %}

{% block title %}Quotes{% endblock %}

{% block body %}
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Quotes</h1>
        <a href="{{ path('app_quote_new') }}" class="bg-gray-900 text-white px-4 py-2 rounded text-sm hover:bg-gray-700 transition">New Quote</a>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
        <table class="w-full text-left">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-xs text-gray-400 uppercase tracking-widest">Number</th>
                    <th class="px-6 py-3 text-xs text-gray-400 uppercase tracking-widest">Client</th>
                    <th class="px-6 py-3 text-xs text-gray-400 uppercase tracking-widest">Date</th>
                    <th class="px-6 py-3 text-xs text-gray-400 uppercase tracking-widest">Status</th>
                    <th class="px-6 py-3 text-xs text-gray-400 uppercase tracking-widest">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for quote in quotes %}
                <tr class="border-t border-gray-100 hover:bg-gray-50">
                    <td class="px-6 py-4 font-medium text-gray-900">{{ quote.quoteNumber }}</td>
                    <td class="px-6 py-4 text-gray-500 text-sm">{{ quote.client.name }}</td>
                    <td class="px-6 py-4 text-gray-500 text-sm">{{ quote.createdAt|date('d/m/Y') }}</td>
                    <td class="px-6 py-4">
                        <span class="text-xs px-2 py-1 rounded-full bg-gray-100 text-gray-600 capitalize">{{ quote.status.value }}</span>
                    </td>
                    <td class="px-6 py-4 flex gap-3">
                        <a href="{{ path('app_quote_show', {'id': quote.id}) }}" class="text-sm text-gray-500 hover:text-gray-900 transition">View</a>
                        <a href="{{ path('app_quote_edit', {'id': quote.id}) }}" class="text-sm text-gray-500 hover:text-gray-900 transition">Edit</a>
                        <a href="{{ path('app_quote_pdf', {'id': quote.id}) }}" class="text-sm text-gray-500 hover:text-gray-900 transition">PDF</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-400 text-sm">No quotes found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
