{% extends 'base.html.twig' %}

{% block title %}{{ 'quote.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">{{ 'quote.title'|trans }}</h1>
        <a href="{{ path('app_quote_new', {'_locale': app.request.locale}) }}" class="btn-primary">{{ 'quote.new'|trans }}</a>
    </div>

    <div class="table-wrapper">
        <table class="w-full text-left">
            <thead class="bg-gray-50">
                <tr>
                    <th class="table-header">{{ 'quote.number'|trans }}</th>
                    <th class="table-header">{{ 'quote.client'|trans }}</th>
                    <th class="table-header">{{ 'quote.date'|trans }}</th>
                    <th class="table-header">{{ 'quote.status'|trans }}</th>
                    <th class="table-header">{{ 'common.actions'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for quote in quotes %}
                <tr class="border-t border-gray-100 hover:bg-gray-50">
                    <td class="table-cell-primary">{{ quote.quoteNumber }}</td>
                    <td class="table-cell">{{ quote.client.name }}</td>
                    <td class="table-cell">{{ quote.createdAt|date('d/m/Y') }}</td>
                    <td class="table-cell">
                        <span class="badge">{{ ('status.' ~ quote.status.value)|trans }}</span>
                    </td>
                    <td class="table-cell flex gap-3">
                        <a href="{{ path('app_quote_show', {'id': quote.id, '_locale': app.request.locale}) }}" class="link">{{ 'common.view'|trans }}</a>
                        <a href="{{ path('app_quote_edit', {'id': quote.id, '_locale': app.request.locale}) }}" class="link">{{ 'common.edit'|trans }}</a>
                        <a href="{{ path('app_quote_pdf', {'id': quote.id, '_locale': app.request.locale}) }}" class="link">PDF</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-400 text-sm">{{ 'common.no_results'|trans }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
