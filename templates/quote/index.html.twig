{% extends 'base.html.twig' %}

{% block title %}Quotes{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Quotes</h1>
        <a href="{{ path('app_quote_new') }}" class="btn-primary">New Quote</a>
    </div>

    <div class="table-wrapper">
        <table class="w-full text-left">
            <thead class="bg-gray-50">
                <tr>
                    <th class="table-header">Number</th>
                    <th class="table-header">Client</th>
                    <th class="table-header">Date</th>
                    <th class="table-header">Status</th>
                    <th class="table-header">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for quote in quotes %}
                <tr class="border-t border-gray-100 hover:bg-gray-50">
                    <td class="table-cell-primary">{{ quote.quoteNumber }}</td>
                    <td class="table-cell">{{ quote.client.name }}</td>
                    <td class="table-cell">{{ quote.createdAt|date('d/m/Y') }}</td>
                    <td class="table-cell">
                        <span class="badge">{{ quote.status.value }}</span>
                    </td>
                    <td class="table-cell flex gap-3">
                        <a href="{{ path('app_quote_show', {'id': quote.id}) }}" class="link">View</a>
                        <a href="{{ path('app_quote_edit', {'id': quote.id}) }}" class="link">Edit</a>
                        <a href="{{ path('app_quote_pdf', {'id': quote.id}) }}" class="link">PDF</a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-400 text-sm">No quotes found</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
