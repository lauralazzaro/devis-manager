{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
    <div>
        {{ form_label(form.quoteNumber, 'Quote Number', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.quoteNumber, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.quoteNumber) }}
    </div>
    <div>
        {{ form_label(form.createdAt, 'Date', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.createdAt, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.createdAt) }}
    </div>
    <div>
        {{ form_label(form.status, 'Status', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.status, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.status) }}
    </div>
    <div>
        {{ form_label(form.client, 'Client', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
        {{ form_widget(form.client, {'attr': {'class': 'w-full border border-gray-200 rounded px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-gray-400'}}) }}
        {{ form_errors(form.client) }}
    </div>
    <button type="submit" class="bg-gray-900 text-white px-6 py-2 rounded text-sm hover:bg-gray-700 transition">
        {{ button_label|default('Save') }}
    </button>
{{ form_end(form) }}
