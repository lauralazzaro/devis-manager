{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }}{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">{{ 'dashboard.title'|trans }}</h1>
    </div>

    <div class="grid grid-cols-3 gap-6 mb-8">
        <div class="card">
            <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'dashboard.clients'|trans }}</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalClients }}</p>
        </div>
        <div class="card">
            <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'dashboard.quotes'|trans }}</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalQuotes }}</p>
        </div>
        <div class="card">
            <p class="text-xs text-gray-400 uppercase tracking-widest">{{ 'dashboard.accepted_revenue'|trans }}</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalRevenue }} EUR</p>
        </div>
    </div>

    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">{{ 'dashboard.quotes_by_status'|trans }}</h2>
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="table-header">{{ 'quote.status'|trans }}</th>
                    <th class="table-header">{{ 'dashboard.quotes'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for status, count in quotesByStatus %}
                <tr class="border-b border-gray-50 last:border-0">
                    <td class="table-cell capitalize">{{ ('status.' ~ status)|trans }}</td>
                    <td class="table-cell font-semibold text-gray-900">{{ count }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="flex gap-3">
        <a href="{{ path('app_quote_new') }}" class="btn-primary">{{ 'dashboard.new_quote'|trans }}</a>
        <a href="{{ path('app_client_index') }}" class="btn-secondary">{{ 'dashboard.manage_clients'|trans }}</a>
    </div>
{% endblock %}
