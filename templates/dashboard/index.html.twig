{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Dashboard</h1>

    <div class="grid grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <p class="text-xs text-gray-400 uppercase tracking-widest">Clients</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalClients }}</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <p class="text-xs text-gray-400 uppercase tracking-widest">Quotes</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalQuotes }}</p>
        </div>
        <div class="bg-white rounded-lg border border-gray-200 p-6">
            <p class="text-xs text-gray-400 uppercase tracking-widest">Accepted Revenue</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalRevenue }} EUR</p>
        </div>
    </div>

    <div class="bg-white rounded-lg border border-gray-200 p-6 mb-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Quotes by Status</h2>
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="pb-3 text-xs text-gray-400 uppercase tracking-widest">Status</th>
                    <th class="pb-3 text-xs text-gray-400 uppercase tracking-widest">Count</th>
                </tr>
            </thead>
            <tbody>
                {% for status, count in quotesByStatus %}
                <tr class="border-b border-gray-50 last:border-0">
                    <td class="py-3 text-sm capitalize text-gray-600">{{ status }}</td>
                    <td class="py-3 text-sm font-semibold text-gray-900">{{ count }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="flex gap-3">
        <a href="{{ path('app_quote_new') }}" class="bg-gray-900 text-white px-4 py-2 rounded text-sm hover:bg-gray-700 transition">New Quote</a>
        <a href="{{ path('app_client_index') }}" class="border border-gray-300 text-gray-600 px-4 py-2 rounded text-sm hover:bg-gray-50 transition">Manage Clients</a>
    </div>
{% endblock %}
