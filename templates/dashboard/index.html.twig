{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-title">Dashboard</h1>
    </div>

    <div class="grid grid-cols-3 gap-6 mb-8">
        <div class="card">
            <p class="text-xs text-gray-400 uppercase tracking-widest">Clients</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalClients }}</p>
        </div>
        <div class="card">
            <p class="text-xs text-gray-400 uppercase tracking-widest">Quotes</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalQuotes }}</p>
        </div>
        <div class="card">
            <p class="text-xs text-gray-400 uppercase tracking-widest">Accepted Revenue</p>
            <p class="text-4xl font-bold text-gray-900 mt-2">{{ totalRevenue }} EUR</p>
        </div>
    </div>

    <div class="card mb-8">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Quotes by Status</h2>
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="table-header">Status</th>
                    <th class="table-header">Count</th>
                </tr>
            </thead>
            <tbody>
                {% for status, count in quotesByStatus %}
                <tr class="border-b border-gray-50 last:border-0">
                    <td class="table-cell capitalize">{{ status }}</td>
                    <td class="table-cell font-semibold text-gray-900">{{ count }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="flex gap-3">
        <a href="{{ path('app_quote_new') }}" class="btn-primary">New Quote</a>
        <a href="{{ path('app_client_index') }}" class="btn-secondary">Manage Clients</a>
    </div>
{% endblock %}
