<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Devis Manager{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-gray-50 text-gray-800 min-h-screen">

        <nav class="bg-white border-b border-gray-200 mb-8">
            <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
                <div class="flex items-center gap-8">
                    <span class="font-semibold text-gray-900 tracking-tight">Devis Manager</span>
                    <div class="flex gap-6">
                        <a href="{{ path('app_dashboard') }}" class="link">{{ 'nav.dashboard'|trans }}</a>
                        <a href="{{ path('app_client_index') }}" class="link">{{ 'nav.clients'|trans }}</a>
                        <a href="{{ path('app_quote_index') }}" class="link">{{ 'nav.quotes'|trans }}</a>
                    </div>
                </div>
                <div class="flex items-center gap-4">
                    {% if app.user %}
                        <span class="text-xs text-gray-400">{{ app.user.email }}</span>
                        <a href="{{ path('app_logout') }}" class="link">{{ 'nav.logout'|trans }}</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="link">{{ 'nav.login'|trans }}</a>
                    {% endif %}

                    {# Language switcher #}
                    <div class="flex gap-2 ml-4">
    <a href="{{ path('app_locale_switch', {'locale': 'en'}) }}" 
       class="text-xs px-2 py-1 rounded {{ app.request.locale == 'en' ? 'bg-gray-900 text-white' : 'text-gray-400 hover:text-gray-900' }}">EN</a>
    <a href="{{ path('app_locale_switch', {'locale': 'fr'}) }}" 
       class="text-xs px-2 py-1 rounded {{ app.request.locale == 'fr' ? 'bg-gray-900 text-white' : 'text-gray-400 hover:text-gray-900' }}">FR</a>
    <a href="{{ path('app_locale_switch', {'locale': 'it'}) }}" 
       class="text-xs px-2 py-1 rounded {{ app.request.locale == 'it' ? 'bg-gray-900 text-white' : 'text-gray-400 hover:text-gray-900' }}">IT</a>
</div>
                </div>
            </div>
        </nav>

        <main class="max-w-6xl mx-auto px-6">
            {% for message in app.flashes('success') %}
                <div class="bg-gray-900 text-white px-4 py-3 rounded mb-6 text-sm">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 text-red-700 border border-red-200 px-4 py-3 rounded mb-6 text-sm">{{ message }}</div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

    </body>
</html>
